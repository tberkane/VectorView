# Copy to .env and fill in what you use. Never commit .env.

# Street View Static API keys (API mode). Add _2, _3, ... for more keys; they are used in order.
GSV_API_KEY_1=
# Hard cap on images fetched per key (default 1000). Metadata requests are free and not counted.
GSV_IMAGE_CAP_1=1000

# Postgres + pgvector (ingest, encode, export). Either a URL or the parts below.
# DATABASE_URL=postgresql://vectorview:vectorview@127.0.0.1:5432/vectorview
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=vectorview
PG_USER=vectorview
PG_PASSWORD=vectorview

# Where VectorView writes images, embeddings and state.
VECTORVIEW_DATA_DIR=./data

# LLM query expansion and the OpenAI judge.
OPENAI_API_KEY=
# Gemini judge (the default VLM).
GEMINI_API_KEY=
